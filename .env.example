# Copie para .env e ajuste. A aplicação não sobe se alguma variável obrigatória
# estiver ausente ou inválida. O docker-compose.yml lê este mesmo arquivo.

# ------------------------------------------------------------------------------
# Aplicação
# ------------------------------------------------------------------------------

# Ambiente de execução: development | test | production. Padrão: development.
NODE_ENV=development

# Porta HTTP da API. Padrão: 3000.
PORT=3000

# Prefixo global das rotas (ex.: /api/v1/...). Padrão: api.
API_PREFIX=api

# Obrigatória. Origens liberadas no CORS, separadas por vírgula, no formato
# protocolo://host[:porta], sem barra final. Curinga (*) não é aceito.
CORS_ORIGINS=http://localhost:4200

# Publica a documentação Swagger. Aceita true/false. Padrão: false.
SWAGGER_ENABLED=true

# Caminho da interface Swagger (ex.: /docs). Padrão: docs.
SWAGGER_PATH=docs

# ------------------------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------------------------

# Obrigatórias. Credenciais e endereço do banco.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=ticketforge
DATABASE_PASSWORD=ticketforge_dev
DATABASE_NAME=ticketforge

# Exige TLS com certificado válido. Use true em produção. Padrão: false.
DATABASE_SSL=false

# Registra todas as queries no log. Padrão: false.
DATABASE_LOGGING=false

# Máximo de conexões do pool por instância da API (1 a 100). Padrão: 10.
DATABASE_POOL_MAX=10

# Tempo máximo, em ms, de uma query ou de uma transação ociosa antes de o
# PostgreSQL encerrá-la. Protege contra locks presos. Padrão: 10000.
DATABASE_STATEMENT_TIMEOUT_MS=10000

# ------------------------------------------------------------------------------
# Redis
# ------------------------------------------------------------------------------

# Obrigatórias. Endereço e senha (requirepass) do Redis.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=ticketforge_dev

# Índice do banco lógico (0 a 15). Padrão: 0.
REDIS_DB=0

# ------------------------------------------------------------------------------
# JWT
# ------------------------------------------------------------------------------

# Obrigatórias. Segredos com no mínimo 32 caracteres, diferentes entre si.
# Gere cada um com:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Obrigatórias. Validade dos tokens no formato <número><s|m|h|d>. A do refresh
# precisa ser maior que a do access e também define o TTL da sessão no Redis.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
